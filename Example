--[[
    NodeUI Example Script (Using your Source folder base URL)
]]

local RunService = game:GetService("RunService")

-- Your exact base Source URL from GitHub
local baseUrl = "https://raw.githubusercontent.com/hello12339/NodeUI/refs/heads/main/Source"

-- Automatically targets the main library file inside your Source directory
local success, result = pcall(function()
    return game:HttpGet(baseUrl .. "")
end)

if not success or not result then
    warn("Failed to fetch NodeUI library: " .. tostring(result))
    return
end

local loadSuccess, ImGui = pcall(function()
    return loadstring(result)()
end)

if not loadSuccess or type(ImGui) ~= "table" then
    warn("Failed to initialize NodeUI: " .. tostring(ImGui))
    return
end

-- Example Demo UI Setup
local windowOpen = true
local sliderValue = 50
local toggleState = false

RunService.Heartbeat:Connect(function(deltaTime)
    ImGui.NewFrame()

    if windowOpen then
        local open = ImGui.Begin("NodeUI Demo", {
            x = 100, y = 100, w = 300, h = 250,
            closable = true,
        })

        if open then
            local changed
            changed, toggleState = ImGui.Checkbox("Enable Feature", toggleState)
            changed, sliderValue = ImGui.SliderFloat("Value", sliderValue, 0, 100, "%.0f")

            if ImGui.Button("Print Status") then
                print("Feature enabled:", toggleState, "Slider value:", sliderValue)
            end

            ImGui.End()
        else
            windowOpen = false
        end
    end

    ImGui.EndFrame()
end)
