		swatch.AnchorPoint = Vector2.new(1, 0.5)
		swatch.Position = UDim2.new(1, 0, 0.5, 0)
		swatch.Size = UDim2.fromOffset(32, 18)
		swatch.AutoButtonColor = false
		swatch.Text = ""
		swatch.Parent = row
		corner(swatch, Style.FrameRounding)

		-- Popup: PopupBg background, same anchor idea as Combo's list
		local popup = Instance.new("Frame")
		popup.Name = "Popup"
		popup.BackgroundColor3 = Style.PopupBg
		popup.BackgroundTransparency = Style.PopupBgTransparency
		popup.AnchorPoint = Vector2.new(1, 0)
		popup.Position = UDim2.new(1, 0, 1, 4)
		popup.Size = UDim2.fromOffset(180, 0)
		popup.AutomaticSize = Enum.AutomaticSize.Y
		popup.Visible = false
		popup.ZIndex = 10
		popup.Parent = row
		stroke(popup, Style.Border, Style.BorderTransparency, 1)

		local popupLayout = Instance.new("UIListLayout")
		popupLayout.SortOrder = Enum.SortOrder.LayoutOrder
		popupLayout.Padding = UDim.new(0, 6)
		popupLayout.Parent = popup

		local popupPadding = Instance.new("UIPadding")
		popupPadding.PaddingTop = UDim.new(0, 8)
		popupPadding.PaddingBottom = UDim.new(0, 8)
		popupPadding.PaddingLeft = UDim.new(0, 8)
		popupPadding.PaddingRight = UDim.new(0, 8)
		popupPadding.Parent = popup

		local preview = Instance.new("Frame")
		preview.Name = "Preview"
		preview.Size = UDim2.new(1, 0, 0, 28)
		preview.LayoutOrder = 1
		preview.BorderSizePixel = 0
		preview.Parent = popup
		corner(preview, Style.FrameRounding)

		local hueBar, hueGrad, hueInd, hueHit = createHSVBar(popup, 2)
		local satBar, satGrad, satInd, satHit = createHSVBar(popup, 3)
		local valBar, valGrad, valInd, valHit = createHSVBar(popup, 4)

		-- Hue's gradient is fixed (the full rainbow) and never changes.
		hueGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1, 1, 1)),
		})

		local hexLabel = Instance.new("TextLabel")
		hexLabel.Name = "HexLabel"
		hexLabel.BackgroundTransparency = 1
		hexLabel.Size = UDim2.new(1, 0, 0, 16)
		hexLabel.LayoutOrder = 5
		hexLabel.Font = Style.Font
		hexLabel.TextSize = Style.TextSize
		hexLabel.TextColor3 = Style.TextDisabled
		hexLabel.TextXAlignment = Enum.TextXAlignment.Left
		hexLabel.Parent = popup

		-- Recomputes everything (swatch, preview, both dependent
		-- gradients, the three indicator positions, the hex readout)
		-- from the current state.h/s/v. markChanged is only true when
		-- called from an actual drag, not from the initial paint.
		local function recompute(markChanged)
			state.value = Color3.fromHSV(state.h, state.s, state.v)

			row.Swatch.BackgroundColor3 = state.value
			preview.BackgroundColor3 = state.value

			satGrad.Color = ColorSequence.new(
				Color3.fromHSV(state.h, 0, state.v),
				Color3.fromHSV(state.h, 1, state.v)
			)
			valGrad.Color = ColorSequence.new(
				Color3.fromHSV(state.h, state.s, 0),
				Color3.fromHSV(state.h, state.s, 1)
			)

			hueInd.Position = UDim2.new(state.h, 0, 0, 0)
			satInd.Position = UDim2.new(state.s, 0, 0, 0)
			valInd.Position = UDim2.new(state.v, 0, 0, 0)

			hexLabel.Text = colorToHex(state.value)

			if markChanged then
				state.changed = true
			end
		end

		-- Wires one bar's Hit TextButton to drag-set a given state field
		-- (h, s, or v) by horizontal position, then recompute.
		local function wireBar(bar, hit, field)
			local dragging = false

			local function setFromX(xPos)
				local width = bar.AbsoluteSize.X
				if width <= 0 then return end
				local rel = math.clamp((xPos - bar.AbsolutePosition.X) / width, 0, 1)
				state[field] = rel
				recompute(true)
			end

			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setFromX(input.Position.X)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					setFromX(input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)
		end

		wireBar(hueBar, hueHit, "h")
		wireBar(satBar, satHit, "s")
		wireBar(valBar, valHit, "v")

		swatch.MouseButton1Click:Connect(function()
			state.open = not state.open
		end)

		-- Real Roblox Instances (Frame, etc.) have a fixed, engine-
		-- enforced set of properties — unlike a plain Lua table, you
		-- cannot bolt an arbitrary field like row._recompute onto one;
		-- it throws "X is not a valid member of Frame" immediately.
		-- `state` IS a plain Lua table (from getState), so that's
		-- where persistent closures/references belong instead.
		state.recompute = recompute
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)
	row.Label.Text = visible
	row.Popup.Visible = state.open
	state.recompute(false)

	local changed = state.changed or false
	state.changed = false

	return changed, state.value
end

--========================================================================
-- SEPARATOR
--========================================================================

function ImGui.Separator()
	local win = currentWindow()
	local order = nextOrder()
	local name = "sep_" .. order

	local line = win.body:FindFirstChild(name)

	if not line then
		line = Instance.new("Frame")
		line.Name = name
		line.BackgroundColor3 = Style.Border
		line.BackgroundTransparency = Style.BorderTransparency
		line.BorderSizePixel = 0
		line.Size = UDim2.new(1, 0, 0, 1)
		line.Parent = win.body
	end

	line.LayoutOrder = order
	line:SetAttribute("_imgui_f", ImGui._frame)
end

return ImGui
