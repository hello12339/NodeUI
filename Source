local function colorToHex(c)
	return string.format(
		"#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

-- One Hue/Saturation/Value bar: a gradient-filled track with a thin
-- draggable indicator. Used three times below (once per channel) —
-- each instance's gradient is recomputed by the caller whenever any of
-- h/s/v changes, since e.g. the Saturation bar's endpoint colors
-- depend on the CURRENT Hue and Value, not just on Saturation itself.
local function createHSVBar(parent, order)
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.LayoutOrder = order
	bar:SetAttribute("_imgui_f", ImGui._frame)
	bar.Size = UDim2.new(1, 0, 0, 16)
	bar.BackgroundColor3 = Color3.new(1, 1, 1)
	bar.BorderSizePixel = 0
	bar.Parent = parent
	corner(bar, UDim.new(0, 2))

	local gradient = Instance.new("UIGradient")
	gradient.Parent = bar

	local indicator = Instance.new("Frame")
	indicator.Name = "Indicator"
	indicator.AnchorPoint = Vector2.new(0.5, 0)
	indicator.Size = UDim2.new(0, 2, 1, 0)
	indicator.BackgroundColor3 = Color3.new(1, 1, 1)
	indicator.BorderSizePixel = 0
	indicator.ZIndex = 2
	indicator.Parent = bar
	stroke(indicator, Color3.new(0, 0, 0), 0, 1) -- thin dark outline so it's visible over light gradient regions too

	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.BackgroundTransparency = 1
	hit.AutoButtonColor = false
	hit.Text = ""
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.ZIndex = 3
	hit.Parent = bar

	return bar, gradient, indicator, hit
end

-- A real HSV picker popup, replacing the old "cycle through 7 presets"
