-- Shared by InputText and InputTextWithHint below. `hint`, when given,
-- shows as faint placeholder text (via Roblox's native
-- TextBox.PlaceholderText) that disappears the moment you click in or
-- type — it is NEVER real committed text sitting in the box. This is
-- what upstream's actual InputTextWithHint() does too (hint and value
-- are two separate things there as well, not one field doing double
-- duty) — InputText (no hint) just leaves PlaceholderText empty.
local function inputTextCore(label, hint, value)
	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "inp_" .. id

	local state = getState(scopedId(win, id), {
		value = value or "",
	})

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("Frame")
		row.Name = name
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, Style.FrameHeight)
		row.Parent = win.body

		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(0.4, -4, 1, 0)
		lbl.Font = Style.Font
		lbl.TextSize = Style.TextSize
		lbl.TextColor3 = Style.TextDisabled
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = row

		local box = Instance.new("TextBox")
		box.Name = "Box"
		box.Position = UDim2.new(0.4, 0, 0, 0)
		box.Size = UDim2.new(0.6, 0, 1, 0)
		box.BackgroundColor3 = Style.FrameBg
		box.BackgroundTransparency = Style.FrameBgTransparency
		box.Font = Style.Font
		box.TextSize = Style.TextSize
		box.TextColor3 = Style.Text
		box.TextTransparency = Style.TextTransparency
		box.PlaceholderText = hint or ""
		box.PlaceholderColor3 = Style.TextDisabled
		box.ClearTextOnFocus = false
		box.Parent = row

		corner(box, Style.FrameRounding)

		box.Focused:Connect(function()
			box.BackgroundColor3 = Style.FrameBgActive
			box.BackgroundTransparency = Style.FrameBgActiveTransparency
		end)

		box.FocusLost:Connect(function()
			box.BackgroundColor3 = Style.FrameBg
			box.BackgroundTransparency = Style.FrameBgTransparency
			state.value = box.Text
			state.changed = true
		end)
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)
	row.Label.Text = visible
	row.Box.PlaceholderText = hint or "" -- re-applied every frame in case the caller passes a dynamic hint

	if not row.Box:IsFocused() then
		row.Box.Text = state.value
	end

	local changed = state.changed or false
	state.changed = false

	return changed, state.value
end

-- ImGui.InputText(label, value) -> changed, value
-- No hint — the box starts genuinely empty unless `value` is already
-- non-empty (e.g. restoring a previously-typed value).
function ImGui.InputText(label, value)
	return inputTextCore(label, nil, value)
end

-- ImGui.InputTextWithHint(label, hint, value) -> changed, value
-- `hint` is faint placeholder text shown only while the box is empty;
-- it is never inserted into the actual value.
function ImGui.InputTextWithHint(label, hint, value)
	return inputTextCore(label, hint, value)
end

