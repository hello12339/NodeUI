-- Repaints one option row's background to match its current selected /
-- hovered state. Pulled out so both the create-time initial paint and
-- the MouseEnter/MouseLeave handlers can share one code path.
local function paintComboOption(opt, selected, hovered)
	if selected then
		opt.BackgroundColor3 = Style.HeaderActive
		opt.BackgroundTransparency = Style.HeaderActiveTransparency
	elseif hovered then
		opt.BackgroundColor3 = Style.HeaderHovered
		opt.BackgroundTransparency = Style.HeaderHoveredTransparency
	else
		opt.BackgroundTransparency = 1
	end
end

function ImGui.Combo(label, items, currentIndex)
	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "cmb_" .. id

	local state = getState(scopedId(win, id), {
		index = currentIndex or 1,
		open = false,
		-- Persistent option-button cache, keyed by index — a plain Lua
		-- table (NOT stored on any Instance; Roblox Instances don't
		-- allow arbitrary custom fields, same lesson as the earlier
		-- _popup/_recompute bug). Each entry is {button, hovered}.
		options = {},
	})

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("Frame")
		row.Name = name
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, Style.FrameHeight)
		row.ClipsDescendants = false
		-- Bumped well above any plausible sibling widget's ZIndex (was
		-- 5, barely above a default of 1) so the open popup is never
		-- ambiguous about rendering/input priority over nearby widgets.
		row.ZIndex = 50
		row.Parent = win.body

		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(0.4, -4, 1, 0)
		lbl.Font = Style.Font
		lbl.TextSize = Style.TextSize
		lbl.TextColor3 = Style.TextDisabled
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = row

		local box = Instance.new("TextButton")
		box.Name = "Box"
		box.AutoButtonColor = false
		box.Position = UDim2.new(0.4, 0, 0, 0)
		box.Size = UDim2.new(0.6, 0, 1, 0)
		box.BackgroundColor3 = Style.FrameBg
		box.BackgroundTransparency = Style.FrameBgTransparency
		box.Font = Style.Font
		box.TextSize = Style.TextSize
		box.TextColor3 = Style.Text
		box.TextTransparency = Style.TextTransparency
		box.TextXAlignment = Enum.TextXAlignment.Left -- was defaulting to Center, unlike every other frame widget's text
		box.Parent = row

		corner(box, Style.FrameRounding)
		stroke(box, Style.Border, Style.BorderTransparency, 1)

		local boxPadding = Instance.new("UIPadding")
		boxPadding.PaddingLeft = UDim.new(0, Style.FramePaddingX + 2)
		boxPadding.PaddingRight = UDim.new(0, 20) -- room for the arrow so long option text doesn't run under it
		boxPadding.Parent = box

		-- box previously had no hover feedback at all — unlike every
		-- other frame widget (Button, Checkbox, sliders, InputText),
		-- it just sat static. Now it lightens the same way they do.
		box.MouseEnter:Connect(function()
			box.BackgroundColor3 = Style.FrameBgHovered
			box.BackgroundTransparency = Style.FrameBgHoveredTransparency
		end)
		box.MouseLeave:Connect(function()
			box.BackgroundColor3 = Style.FrameBg
			box.BackgroundTransparency = Style.FrameBgTransparency
		end)

		-- Same image asset + tween as the window's own collapse button
		-- and CollapsingHeader (was a Unicode ▼ glyph, then a plain
		-- geometric chevron — neither matched the rest of the library's
		-- collapse affordances, so this now does exactly what was
		-- asked: "add the collapsing icon to it and its tween").
		local arrow = Instance.new("ImageLabel")
		arrow.Name = "Arrow"
		arrow.BackgroundTransparency = 1
		arrow.AnchorPoint = Vector2.new(1, 0.5)
		arrow.Position = UDim2.new(1, -8, 0.5, -6)
		arrow.Size = UDim2.fromOffset(12, 12)
		arrow.Image = COLLAPSE_ICON
		arrow.ImageColor3 = Style.TextDisabled
		arrow.ImageTransparency = 0
		arrow.ScaleType = Enum.ScaleType.Fit
		-- Same convention as CollapsingHeader: -90 open, 0 closed/idle.
		arrow.Rotation = state.open and -90 or 0
		arrow.ZIndex = 2
		arrow.Parent = box

		local function animateArrow()
			if state.arrowTween then
				state.arrowTween:Cancel()
				state.arrowTween = nil
			end
			local targetRotation = state.open and -90 or 0
			local tween = TweenService:Create(
				arrow,
				TweenInfo.new(COLLAPSE_ANIMATION_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Rotation = targetRotation }
			)
			state.arrowTween = tween
			tween:Play()
		end

		local list = Instance.new("Frame")
		list.Name = "List"
		list.BackgroundColor3 = Style.PopupBg
		list.BackgroundTransparency = Style.PopupBgTransparency
		list.Position = UDim2.new(0.4, 0, 1, 2)
		list.Size = UDim2.new(0.6, 0, 0, 0)
		list.AutomaticSize = Enum.AutomaticSize.Y
		list.Visible = false
		list.ZIndex = 60
		list.Parent = row

		stroke(list, Style.Border, Style.BorderTransparency, 1)

		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Parent = list

		local listPadding = Instance.new("UIPadding")
		listPadding.PaddingTop = UDim.new(0, 2)
		listPadding.PaddingBottom = UDim.new(0, 2)
		listPadding.Parent = list

		box.MouseButton1Click:Connect(function()
			state.open = not state.open
			animateArrow()
		end)
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)
	row.Label.Text = visible
	row.Box.Text = items[state.index] or "..."
	row.List.Visible = state.open

	-- Options are created ONCE per index and reused every frame from
	-- here on — they used to be destroyed and fully recreated on every
	-- single call (i.e. every frame), which is why hover highlighting
	-- never stuck (MouseEnter doesn't fire just because a brand-new
	-- Instance happens to appear under an already-stationary cursor)
	-- and clicks could get silently dropped (destroying a TextButton
	-- mid MouseButton1Down/Up pair cancels the click). This is the
	-- actual root cause of "no hover" and "can't select" — now fixed.
	for i, item in ipairs(items) do
		local entry = state.options[i]

		if not entry then
			local opt = Instance.new("TextButton")
			opt.AutoButtonColor = false
			opt.Size = UDim2.new(1, 0, 0, 24)
			opt.Font = Style.Font
			opt.TextSize = Style.TextSize
			opt.TextColor3 = Style.Text
			opt.TextXAlignment = Enum.TextXAlignment.Left
			opt.LayoutOrder = i
			opt.ZIndex = 61
			opt.Parent = row.List

			local optPadding = Instance.new("UIPadding")
			optPadding.PaddingLeft = UDim.new(0, Style.FramePaddingX + 2)
			optPadding.Parent = opt

			entry = { button = opt, hovered = false }
			state.options[i] = entry

			opt.MouseEnter:Connect(function()
				entry.hovered = true
				paintComboOption(opt, state.index == i, true)
			end)
			opt.MouseLeave:Connect(function()
				entry.hovered = false
				paintComboOption(opt, state.index == i, false)
			end)
			opt.MouseButton1Click:Connect(function()
				state.index = i
				state.open = false
				state.changed = true
			end)
		end

		entry.button.Text = item
		paintComboOption(entry.button, state.index == i, entry.hovered)
	end

	-- If the caller ever passes a SHORTER items list than before,
	-- remove the now-unused trailing cached option buttons rather than
	-- leaving stale ones sitting in the popup forever.
	for i = #items + 1, #state.options do
		if state.options[i] then
			state.options[i].button:Destroy()
			state.options[i] = nil
		end
	end

	local changed = state.changed or false
	state.changed = false

	return changed, state.index
end

