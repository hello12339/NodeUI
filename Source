function ImGui.Button(label, opts)
	opts = opts or {}

	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "btn_" .. id

	local state = getState(scopedId(win, id), {
		clicked = false,
		hovered = false,
		down = false,
	})

	local btn = win.body:FindFirstChild(name)

	if not btn then
		btn = Instance.new("TextButton")
		btn.Name = name
		btn.AutoButtonColor = false
		btn.Size = UDim2.new(1, 0, 0, opts.h or Style.FrameHeight)
		btn.Font = Style.Font
		btn.TextSize = Style.TextSize
		btn.TextColor3 = Style.Text
		btn.TextTransparency = Style.TextTransparency
		btn.Parent = win.body

		corner(btn, Style.FrameRounding)

		btn.MouseEnter:Connect(function()
			state.hovered = true
		end)

		btn.MouseLeave:Connect(function()
			state.hovered = false
		end)

		btn.MouseButton1Down:Connect(function()
			state.down = true
		end)

		btn.MouseButton1Up:Connect(function()
			state.down = false
		end)

		btn.MouseButton1Click:Connect(function()
			state.clicked = true
		end)
	end

	btn.LayoutOrder = order
	btn:SetAttribute("_imgui_f", ImGui._frame)
	btn.Text = visible

	if state.down then
		btn.BackgroundColor3 = Style.ButtonActive
		btn.BackgroundTransparency = Style.ButtonActiveTransparency
	elseif state.hovered then
		btn.BackgroundColor3 = Style.ButtonHovered
		btn.BackgroundTransparency = Style.ButtonHoveredTransparency
	else
		btn.BackgroundColor3 = Style.Button
		btn.BackgroundTransparency = Style.ButtonTransparency
	end

	local wasClicked = state.clicked
	state.clicked = false

	return wasClicked
end

--========================================================================
-- COLLAPSING HEADER
--========================================================================

-- Matches upstream's actual usage pattern: a full-width clickable row
-- with an arrow that flips between ▸ (closed) and ▾ (open), painted
-- with the same Header/HeaderHovered/HeaderActive colors as a Tab or a
-- Combo's selected row — this is the widget behind the "▶ Help",
-- "▶ Configuration" etc. rows in the real ImGui demo. Returns whether
-- it's currently open; the caller wraps their own content in the if:
--   if ImGui.CollapsingHeader("Help") then
--       ImGui.Text("...")
--   end
function ImGui.CollapsingHeader(label, defaultOpen)
	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "hdr_" .. id

	local state = getState(scopedId(win, id), {
		open = defaultOpen or false,
		hovered = false,
		down = false,
	})

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("TextButton")
		row.Name = name
		row.AutoButtonColor = false
		row.Size = UDim2.new(1, 0, 0, Style.FrameHeight)
		row.Text = ""
		row.Parent = win.body
		corner(row, Style.FrameRounding)

		-- Uses the SAME image asset as the window's own collapse
		-- button (COLLAPSE_ICON), instead of a Unicode ▾/▸ text glyph
		-- like before. Roblox's built-in fonts frequently don't
		-- include triangle/symbol glyphs, so that rendered as nothing
		-- — this is a real, proven-working asset instead.
		local arrow = Instance.new("ImageLabel")
		arrow.Name = "Arrow"
		arrow.BackgroundTransparency = 1
		arrow.Size = UDim2.fromOffset(12, 12)
		arrow.Position = UDim2.new(0, 8, 0.5, -6)
		arrow.Image = COLLAPSE_ICON
		arrow.ImageColor3 = Style.Text
		arrow.ImageTransparency = Style.TextTransparency
		arrow.ScaleType = Enum.ScaleType.Fit
		-- -90 when OPEN, 0 when collapsed/idle (flipped from the first
		-- version per feedback — this now matches what reads correctly
		-- here, even though it's the opposite mapping the window's own
		-- collapse button uses). Snapped once at creation to match
		-- defaultOpen; after this, only the tween below ever moves it.
		arrow.Rotation = state.open and -90 or 0
		arrow.Parent = row

		local text = Instance.new("TextLabel")
		text.Name = "Label"
		text.BackgroundTransparency = 1
		text.Position = UDim2.fromOffset(26, 0)
		text.Size = UDim2.new(1, -30, 1, 0)
		text.Font = Style.FontBold
		text.TextSize = Style.TextSize
		text.TextColor3 = Style.Text
		text.TextTransparency = Style.TextTransparency
		text.TextXAlignment = Enum.TextXAlignment.Left
		text.Parent = row

		-- Same tween as the window's own animateCollapseIcon (0.16s,
		-- Quad, EasingDirection.Out) — the tween reference lives in
		-- `state` (a plain Lua table from getState), not on the
		-- Instance itself, same reason as the earlier _popup/_recompute
		-- fix: Roblox Instances don't allow arbitrary custom fields.
		local function animateArrow()
			if state.arrowTween then
				state.arrowTween:Cancel()
				state.arrowTween = nil
			end
			local targetRotation = state.open and -90 or 0
			local tween = TweenService:Create(
				arrow,
				TweenInfo.new(COLLAPSE_ANIMATION_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Rotation = targetRotation }
			)
			state.arrowTween = tween
			tween:Play()
		end

		row.MouseEnter:Connect(function() state.hovered = true end)
		row.MouseLeave:Connect(function() state.hovered = false end)
		row.MouseButton1Down:Connect(function() state.down = true end)
		row.MouseButton1Up:Connect(function() state.down = false end)
		row.MouseButton1Click:Connect(function()
			state.open = not state.open
			animateArrow()
		end)
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)
	row.Label.Text = visible
	-- Rotation is NOT set here every frame anymore — the tween above
	-- owns it now. Setting it unconditionally every frame would snap
	-- it back instantly and fight the animation, defeating the tween
	-- entirely.

	if state.down then
		row.BackgroundColor3 = Style.HeaderActive
		row.BackgroundTransparency = Style.HeaderActiveTransparency
	elseif state.hovered then
		row.BackgroundColor3 = Style.HeaderHovered
		row.BackgroundTransparency = Style.HeaderHoveredTransparency
	else
		row.BackgroundColor3 = Style.Header
		row.BackgroundTransparency = Style.HeaderTransparency
	end

	return state.open
end

--========================================================================
-- CHECKBOX
--========================================================================

function ImGui.Checkbox(label, value)
	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "chk_" .. id

	local state = getState(scopedId(win, id), {
		value = value,
		hovered = false,
	})

	if value ~= nil and state.value == nil then
		state.value = value
	end

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("TextButton")
		row.Name = name
		row.AutoButtonColor = false
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, Style.FrameHeight)
		row.Text = ""
		row.Parent = win.body

		-- Upstream ties the checkbox box size directly to
		-- GetFrameHeight() (same formula as every other frame widget),
		-- not an unrelated hardcoded 18px square.
		local box = Instance.new("Frame")
		box.Name = "Box"
		box.Size = UDim2.fromOffset(Style.FrameHeight, Style.FrameHeight)
		box.Position = UDim2.new(0, 0, 0.5, -Style.FrameHeight / 2)
		box.BackgroundColor3 = Style.FrameBg
		box.BackgroundTransparency = Style.FrameBgTransparency
		box.Parent = row

		corner(box, Style.FrameRounding)

		-- Image checkmark. Scaled to 140% of the box (not 100%) because
		-- the icon asset itself has transparent padding baked in, so a
		-- 1:1 fit reads as a small checkmark floating in a big box —
		-- this compensates. AnchorPoint+Position keep it centered, and
		-- the box has no ClipsDescendants so the slight overscale is
		-- never cut off.
		local check = Instance.new("ImageLabel")
		check.Name = "Check"
		check.AnchorPoint = Vector2.new(0.5, 0.5)
		check.Position = UDim2.fromScale(0.5, 0.5)
		check.Size = UDim2.fromScale(1.4, 1.4)
		check.BackgroundTransparency = 1
		check.Image = CHECKMARK_ICON
		check.ImageColor3 = Style.CheckMark
		check.ImageTransparency = Style.CheckMarkTransparency
		check.ScaleType = Enum.ScaleType.Fit
		check.Visible = false
		check.Parent = box

		local text = Instance.new("TextLabel")
		text.Name = "Label"
		text.BackgroundTransparency = 1
		text.Position = UDim2.fromOffset(26, 0)
		text.Size = UDim2.new(1, -26, 1, 0)
		text.Font = Style.Font
		text.TextSize = Style.TextSize
		text.TextColor3 = Style.Text
		text.TextTransparency = Style.TextTransparency
		text.TextXAlignment = Enum.TextXAlignment.Left
		text.Parent = row

		row.MouseEnter:Connect(function()
			box.BackgroundColor3 = Style.FrameBgHovered
			box.BackgroundTransparency = Style.FrameBgHoveredTransparency
		end)

		row.MouseLeave:Connect(function()
			box.BackgroundColor3 = Style.FrameBg
			box.BackgroundTransparency = Style.FrameBgTransparency
		end)

		row.MouseButton1Click:Connect(function()
			state.value = not state.value
			state.changed = true
		end)
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)
	row.Box.Check.Visible = state.value
	row.Box.Check.ImageColor3 = Style.CheckMark
	row.Label.Text = visible

	local changed = state.changed or false
	state.changed = false

	return changed, state.value
end

--========================================================================
-- RADIO BUTTON
--========================================================================

-- Matches upstream's actual signature exactly: bool RadioButton(label,
-- bool active) -> clicked. You call it once per option in a group and
-- drive the group's selection yourself, e.g.:
--   if ImGui.RadioButton("Easy", difficulty == 1) then difficulty = 1 end
--   if ImGui.RadioButton("Hard", difficulty == 2) then difficulty = 2 end
-- Upstream reuses ImGuiCol_CheckMark for the filled dot (not a separate
-- "radio" color) — same here.
function ImGui.RadioButton(label, active)
	local win = currentWindow()
	local order = nextOrder()
	local visible, id = splitLabel(label)
	local name = "radio_" .. id

	local state = getState(scopedId(win, id), {
		clicked = false,
	})

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("TextButton")
		row.Name = name
		row.AutoButtonColor = false
		row.BackgroundTransparency = 1
