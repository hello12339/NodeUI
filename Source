ImGui._frame = 0

function ImGui.NewFrame()
	ImGui._frame = ImGui._frame + 1
end

function ImGui.EndFrame()
	for _, win in pairs(Windows) do
		if win.root then
			win.root.Visible =
				(win.lastSeenFrame == ImGui._frame)
				and win.openFlag
		end
	end
end

