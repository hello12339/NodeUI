-- FrameHeight: upstream's real formula (ImGui::GetFrameHeight()) is
-- FontSize + FramePadding.y*2. Confirmed source value: ImGui's default
-- embedded font (ProggyClean) is 13px, so upstream's OWN default
-- FrameHeight is 13 + 3*2 = 19px — this was previously a disconnected
-- hardcoded 26, nearly 40% taller than the real formula for no
-- documented reason. Computed here from Style.TextSize (14, chosen for
-- Roblox's own fonts, not ProggyClean's 13) so it stays correct if
-- TextSize or FramePaddingY ever change, rather than drifting out of
-- sync as a second hardcoded number.
Style.FrameHeight = Style.TextSize + Style.FramePaddingY * 2

-- Upstream's title bar and tab bar both use this exact same
-- GetFrameHeight() value too — there's no separate formula for either
-- one, so unlike the previous version (which hardcoded both to an
-- unrelated 22), these now just equal FrameHeight directly.
Style.TitleBarHeight = Style.FrameHeight
Style.TabBarHeight = Style.FrameHeight

--========================================================================
-- INTERNAL STATE
--========================================================================

local ImGui = {}

local Windows = {}
local WindowStack = {}
local WidgetState = {}

local ScreenGui = nil

local COLLAPSE_ICON = "rbxassetid://112515660895697"
local COLLAPSE_ROTATION = 0
local COLLAPSE_SIZE = UDim2.fromOffset(14, 14)
local COLLAPSE_ANIMATION_TIME = 0.16

local CHECKMARK_ICON = "rbxassetid://18926561608"

-- Window focus tracking (ImGuiCol_TitleBg vs TitleBgActive): only one
-- window is "focused" at a time. Clicking a window's title bar, body,
-- or any widget focuses it; clicking anywhere else (empty game world,
-- or outside every ImGui window) clears focus, and every window's
-- title bar + tabs drop to their unfocused colors.
local FocusedWindow = nil
local TopZIndex = 100
local focusHookInstalled = false

-- getScreenGui() now prefers gethui() (executor-only protected GUI
-- container) → CoreGui → PlayerGui, so this library works from an
-- executor, a Studio plugin, or a normal LocalScript without erroring
-- on the protected CoreGui service.
local function getScreenGui()
	if ScreenGui and ScreenGui.Parent then
		return ScreenGui
	end

	ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "ImGuiRoot"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.DisplayOrder = 100

	-- CoreGui is a protected service and can't be parented to from a
	-- normal LocalScript. Executors provide gethui() for exactly this
	-- purpose; try it first, then CoreGui, then fall back to PlayerGui
	-- (where it will still work, just be visible in PlayerGui).
	local ok = false
	if gethui then
		ok = pcall(function()
			ScreenGui.Parent = gethui()
		end)
	end
	if not ok then
		ok = pcall(function()
			ScreenGui.Parent = CoreGui
		end)
	end
	if not ok then
		ScreenGui.Parent = PlayerGui
	end

	return ScreenGui
end

--========================================================================
-- HELPERS
--========================================================================

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or Style.FrameRounding
	c.Parent = parent
	return c
end

local function stroke(parent, color, transparency, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Style.Border
	s.Transparency = transparency or 0
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- Squares off the bottom N pixels of an already-rounded element, so a
-- UICorner (which rounds all 4 corners) ends up looking top-rounded /
-- bottom-square — used for tabs (and could be reused for title bars).
local function squareBottomMask(parent, color, transparency, heightPx)
	local mask = Instance.new("Frame")
	mask.Name = "BottomMask"
	mask.BackgroundColor3 = color
	mask.BackgroundTransparency = transparency
	mask.BorderSizePixel = 0
	mask.Size = UDim2.new(1, 0, 0, heightPx)
	mask.Position = UDim2.new(0, 0, 1, -heightPx)
	mask.ZIndex = parent.ZIndex
	mask.Parent = parent
	return mask
end

-- A small down-pointing chevron (two thin bars meeting at a point)
-- built from plain Frames instead of a Unicode ▾/▼ text glyph.
-- Roblox's built-in fonts frequently don't include geometric symbol
-- glyphs at all — confirmed by CollapsingHeader's arrow silently
-- rendering as nothing with one. Pure geometry always renders
-- regardless of font glyph coverage, so this is used wherever the
-- library previously relied on a symbol character.
local function makeChevronDown(parent, size, color, transparency)
	local holder = Instance.new("Frame")
	holder.Name = "Chevron"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size, size)
	holder.Parent = parent

	local function bar(xOffset, rotation)
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Position = UDim2.new(0.5, xOffset, 0.5, 0)
		b.Size = UDim2.fromOffset(math.floor(size * 0.6), 2)
		b.Rotation = rotation
		b.BackgroundColor3 = color
		b.BackgroundTransparency = transparency
		b.BorderSizePixel = 0
		b.Parent = holder
		return b
	end

	local left = bar(-math.floor(size * 0.17), 45)
	local right = bar(math.floor(size * 0.17), -45)

	return holder, left, right
end

-- A genuine filled right-triangle in the bottom-right corner (matching
-- the look of the original ◢ glyph — "BLACK LOWER RIGHT TRIANGLE" —
-- rather than a dot cluster), built with a well-known Frame-only trick:
-- a square ~1.4x the container's size, rotated 45°, centered exactly
-- on the container's own bottom-right corner point. Since a square
-- rotated 45° is a diamond whose four corners point up/down/left/right
-- from its center, and the container only extends up-and-left from
-- that corner, only the up-left QUARTER of the diamond falls inside
-- the container's bounds — and that quarter is itself a right
-- triangle, with its right-angle vertex sitting exactly at the corner.
-- parent.ClipsDescendants = true cuts away the rest of the diamond.
local function makeResizeTriangle(parent, color, transparency)
	parent.ClipsDescendants = true

	local size = parent.AbsoluteSize.X > 0 and parent.AbsoluteSize.X or parent.Size.X.Offset
	local wedge = Instance.new("Frame")
	wedge.Name = "Wedge"
	wedge.AnchorPoint = Vector2.new(0.5, 0.5)
	wedge.Position = UDim2.new(1, 0, 1, 0)
	wedge.Size = UDim2.fromOffset(size * 1.4, size * 1.4)
	wedge.Rotation = 45
	wedge.BackgroundColor3 = color
	wedge.BackgroundTransparency = transparency
	wedge.BorderSizePixel = 0
	wedge.Parent = parent

	return wedge
end

local function splitLabel(label)
	local visible = label:match("^(.-)##")
	if visible then
		return visible, label
	end

	return label, label
end

local function getState(id, defaults)
	local s = WidgetState[id]

	if not s then
		s = {}

		for k, v in pairs(defaults) do
			s[k] = v
		end

		WidgetState[id] = s
	end

	return s
end

-- ID stack (PushID/PopID), same purpose as upstream's: lets a loop that
-- creates several widgets with the same label give each one distinct
-- state. This also fixes a real bug that existed before PushID was
-- added at all — WidgetState was keyed by the bare label text with NO
-- window scoping, so two different windows each containing e.g. a
-- Checkbox("Enabled", ...) silently shared one stored boolean. scopedId
-- below always prefixes with the window's title, so that collision is
-- gone regardless of whether the caller ever uses PushID.
local IDStack = {}

function ImGui.PushID(id)
	table.insert(IDStack, tostring(id))
end

function ImGui.PopID()
	table.remove(IDStack)
end

local function scopedId(win, id)
	if #IDStack > 0 then
		return win.title .. "##" .. table.concat(IDStack, "/") .. "##" .. id
	end
	return win.title .. "##" .. id
end

local function currentWindow()
	return WindowStack[#WindowStack]
end

local function nextOrder()
	local win = currentWindow()
	win.nextOrder = win.nextOrder + 1
	return win.nextOrder
end

local function animateCollapseIcon(win, collapsed)
	if not win.collapseIcon then
		return
	end

	if win.collapseTween then
		win.collapseTween:Cancel()
		win.collapseTween = nil
	end

	-- Expanded = 0 degrees (right)
	-- Collapsed = -90 degrees (down)
	local targetRotation = collapsed and -90 or COLLAPSE_ROTATION

	local tween = TweenService:Create(
		win.collapseIcon,
		TweenInfo.new(
			COLLAPSE_ANIMATION_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Rotation = targetRotation
		}
	)

	win.collapseTween = tween
	tween:Play()
end

--========================================================================
-- FOCUS (TitleBg <-> TitleBgActive, and the Tab vs TabUnfocused family)
--========================================================================

local function bringToFront(win)
	TopZIndex = TopZIndex + 1
	win.root.ZIndex = TopZIndex
end

-- Repaints one tab's button to match its current selected / hovered /
-- window-focused state. hovered is only ever true while the mouse is
-- actually over that specific tab (tracked via its own MouseEnter/
-- MouseLeave, stored on the tab table so this can be re-run on focus
-- change too, not just on hover change).
--
-- Also handles the tab-bar separator "merge" effect: upstream draws one
-- continuous Separator line under the whole tab bar, but the ACTIVE
-- tab's bottom edge is drawn a couple pixels further down so it visibly
-- covers that line right under itself — inactive tabs stop short of it,
-- so the line peeks out beneath them. Roblox has no line-under-rect
-- draw-order trick, so this is approximated by literally shrinking the
-- inactive tab buttons by TAB_BAR_GAP pixels so the tab bar's own
-- Underline (a sibling 1px frame at its bottom edge, lower ZIndex than
-- every tab) shows through only in that gap.
local TAB_BAR_GAP = 2

local function paintTab(tab, state, focused)
	local selected = (state.selected == tab.id)
	tab.page.Visible = selected

	local color, transparency
	if selected then
		color = focused and Style.TabActive or Style.TabUnfocusedActive
		transparency = focused and Style.TabActiveTransparency or Style.TabUnfocusedActiveTransparency
	elseif tab.hovered then
		color = Style.HeaderHovered -- upstream: TabHovered = HeaderHovered, no focused/unfocused split
		transparency = Style.HeaderHoveredTransparency
	else
		color = focused and Style.Tab or Style.TabUnfocused
		transparency = focused and Style.TabTransparency or Style.TabUnfocusedTransparency
	end

	tab.button.BackgroundColor3 = color
	tab.button.BackgroundTransparency = transparency
	-- keep the bottom-rounding mask in sync so there's no stale seam
	tab.mask.BackgroundColor3 = color
	tab.mask.BackgroundTransparency = transparency

	tab.button.Size = selected
		and UDim2.new(0, 0, 1, 0)                -- full height: covers the separator line (merged with content)
		or UDim2.new(0, 0, 1, -TAB_BAR_GAP)       -- short: exposes the separator line beneath it
end

local function updateTabVisuals(state, focused)
	for _, tab in ipairs(state.tabs) do
		paintTab(tab, state, focused)
	end
end

local function updateTitleBarColors(win)
	local focused = (FocusedWindow == win)
	win.titleFocused = focused

	win.titleBar.BackgroundColor3 = focused and Style.TitleBgActive or Style.TitleBg
	win.titleBar.BackgroundTransparency = focused and Style.TitleBgActiveTransparency or Style.TitleBgTransparency

	for _, tb in pairs(win.tabBars) do
		updateTabVisuals(tb, focused)
	end
end

local function setFocusedWindow(win)
	if FocusedWindow == win then
		if win then bringToFront(win) end
		return
	end

	local previous = FocusedWindow
	FocusedWindow = win

	if previous then updateTitleBarColors(previous) end
	if win then
		updateTitleBarColors(win)
		bringToFront(win)
	end
end

local function pointInGui(x, y, guiObject)
	local p = guiObject.AbsolutePosition
	local s = guiObject.AbsoluteSize
	return x >= p.X and x <= p.X + s.X and y >= p.Y and y <= p.Y + s.Y
end

-- Installed once: a global click/tap anywhere decides window focus by
-- position, regardless of which child widget (if any) consumed the
-- input — clicking a button inside a window still counts as clicking
-- that window. Clicking outside every window clears focus entirely.
local function installFocusHook()
	if focusHookInstalled then return end
	focusHookInstalled = true

	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local x, y = input.Position.X, input.Position.Y
		local hit, hitZ = nil, -math.huge

		for _, win in pairs(Windows) do
			if win.root and win.root.Visible and pointInGui(x, y, win.root) then
				if win.root.ZIndex > hitZ then
					hit = win
					hitZ = win.root.ZIndex
				end
			end
		end

		setFocusedWindow(hit)
	end)
end

--========================================================================
-- WINDOW CREATION
--========================================================================

local function createWindowInstances(win)
	local root = Instance.new("Frame")
	root.Name = "ImGuiWindow_" .. win.title
	root.Size = UDim2.fromOffset(win.w, win.h)
	root.Position = UDim2.fromOffset(win.x, win.y)
	root.BackgroundColor3 = Style.WindowBg
	root.BackgroundTransparency = Style.WindowBgTransparency
	root.BorderSizePixel = 0
	root.Parent = getScreenGui()

	corner(root, Style.WindowRounding)
	stroke(root, Style.Border, Style.BorderTransparency, Style.WindowBorderSize)

	local titleBar = Instance.new("Frame")
	titleBar.Name = "TitleBar"
	titleBar.Size = UDim2.new(1, 0, 0, Style.TitleBarHeight)
	titleBar.BackgroundColor3 = Style.TitleBg -- starts unfocused; setFocusedWindow() below flips it
	titleBar.BackgroundTransparency = Style.TitleBgTransparency
	titleBar.BorderSizePixel = 0
	titleBar.Parent = root

	corner(titleBar, Style.WindowRounding)

	local btnPad = (Style.TitleBarHeight - Style.ChromeButtonSize) / 2

	-- Collapse button
	local collapseBtn = Instance.new("ImageButton")
	collapseBtn.Name = "CollapseBtn"
	collapseBtn.BackgroundTransparency = 1
	collapseBtn.Size = UDim2.fromOffset(Style.ChromeButtonSize, Style.ChromeButtonSize)
	collapseBtn.Position = UDim2.new(0, 6, 0, btnPad)
	collapseBtn.Image = ""
	collapseBtn.AutoButtonColor = false
	collapseBtn.Parent = titleBar

	-- Actual collapse image
	local collapseIcon = Instance.new("ImageLabel")
	collapseIcon.Name = "Icon"
	collapseIcon.BackgroundTransparency = 1
	collapseIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	collapseIcon.Position = UDim2.fromScale(0.5, 0.5)
	collapseIcon.Size = COLLAPSE_SIZE
	collapseIcon.Image = COLLAPSE_ICON
	collapseIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
	collapseIcon.ImageTransparency = 0
	collapseIcon.Rotation = COLLAPSE_ROTATION
	collapseIcon.ScaleType = Enum.ScaleType.Fit
	collapseIcon.Parent = collapseBtn

	local titleText = Instance.new("TextLabel")
	titleText.Name = "TitleText"
	titleText.BackgroundTransparency = 1
	titleText.Size = UDim2.new(1, -(6 + Style.ChromeButtonSize + 4 + 6 + Style.ChromeButtonSize), 1, 0)
	titleText.Position = UDim2.fromOffset(6 + Style.ChromeButtonSize + 4, 0)
	titleText.Font = Style.FontBold
	titleText.TextSize = Style.TextSize
	titleText.TextColor3 = Style.Text
	titleText.TextTransparency = Style.TextTransparency
	titleText.TextXAlignment = Enum.TextXAlignment.Left
	titleText.Text = win.title
	titleText.Parent = titleBar

	-- Close button
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, -6, 0, btnPad)
	closeBtn.Size = UDim2.fromOffset(Style.ChromeButtonSize, Style.ChromeButtonSize)
	closeBtn.BackgroundColor3 = Style.ButtonHovered
	closeBtn.BackgroundTransparency = 1
	closeBtn.AutoButtonColor = false
	closeBtn.Font = Style.FontBold
	closeBtn.TextSize = 12
	closeBtn.TextColor3 = Style.TextDisabled
	closeBtn.Text = "X"
	closeBtn.Visible = false
	closeBtn.Parent = titleBar

	corner(closeBtn, UDim.new(0, 2))

	closeBtn.MouseEnter:Connect(function()
		closeBtn.BackgroundTransparency = Style.ButtonHoveredTransparency
		closeBtn.TextColor3 = Style.Text
	end)

	closeBtn.MouseLeave:Connect(function()
		closeBtn.BackgroundTransparency = 1
		closeBtn.TextColor3 = Style.TextDisabled
	end)

	closeBtn.MouseButton1Click:Connect(function()
		win.openFlag = false
	end)

	-- Resize grip. Was a Unicode ◢ glyph — same font-glyph-coverage
	-- risk as CollapsingHeader's old arrow, so it's geometry now too.
	local grip = Instance.new("TextButton")
	grip.Name = "ResizeGrip"
	grip.AnchorPoint = Vector2.new(1, 1)
	grip.Position = UDim2.new(1, 0, 1, 0)
	grip.Size = UDim2.fromOffset(16, 16)
	grip.BackgroundTransparency = 1
	grip.AutoButtonColor = false
	grip.Text = ""
	grip.ZIndex = 5
	grip.Parent = root

	local gripWedge = makeResizeTriangle(grip, Style.ResizeGrip, Style.ResizeGripTransparency)

	grip.MouseEnter:Connect(function()
		gripWedge.BackgroundColor3 = Style.ResizeGripHovered
		gripWedge.BackgroundTransparency = Style.ResizeGripHoveredTransparency
	end)

	grip.MouseLeave:Connect(function()
		gripWedge.BackgroundColor3 = Style.ResizeGrip
		gripWedge.BackgroundTransparency = Style.ResizeGripTransparency
	end)

	collapseBtn.MouseButton1Click:Connect(function()
		win.collapsed = not win.collapsed
		animateCollapseIcon(win, win.collapsed)
	end)

	-- Main scrolling body
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Position = UDim2.fromOffset(0, Style.TitleBarHeight)
	body.Size = UDim2.new(1, 0, 1, -Style.TitleBarHeight)
	body.CanvasSize = UDim2.new(0, 0, 0, 0)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollBarThickness = 4
	body.ScrollBarImageColor3 = Style.ScrollbarGrab
	body.ScrollBarImageTransparency = Style.ScrollbarGrabTransparency
	body.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, Style.ItemSpacingY)
	layout.Parent = body

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, Style.WindowPaddingY)
	padding.PaddingBottom = UDim.new(0, Style.WindowPaddingY)
	padding.PaddingLeft = UDim.new(0, Style.WindowPaddingX)
	padding.PaddingRight = UDim.new(0, Style.WindowPaddingX)
	padding.Parent = body

	-- Window dragging (also focuses the window on mouse-down, same as
	-- the global focus hook, so there's no one-frame lag waiting on it)
	local dragging = false
	local dragStart
	local startPos

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			setFocusedWindow(win)

			dragging = true
			dragStart = input.Position
			startPos = root.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then
			local delta = input.Position - dragStart

			root.Position = UDim2.fromOffset(
				startPos.X.Offset + delta.X,
				startPos.Y.Offset + delta.Y
			)

			win.x = root.Position.X.Offset
			win.y = root.Position.Y.Offset
		end
	end)

	-- Window resizing
	local resizing = false
	local resizeStart
	local startSize

	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			resizing = true
			resizeStart = input.Position
			startSize = root.Size

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if resizing and (
			input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then
			local delta = input.Position - resizeStart

			local newW = math.max(180, startSize.X.Offset + delta.X)
			local newH = math.max(120, startSize.Y.Offset + delta.Y)

			root.Size = UDim2.fromOffset(newW, newH)
			win.w = newW
			win.h = newH
		end
	end)

	win.root = root
	win.titleBar = titleBar
	win.body = body
	win.baseBody = body
	win.titleText = titleText
	win.collapseBtn = collapseBtn
	win.collapseIcon = collapseIcon
	win.closeBtn = closeBtn
	win.grip = grip
	win.tabBars = {}
	win.titleFocused = false
end

--========================================================================
-- BEGIN / END
--========================================================================

function ImGui.Begin(title, opts)
	opts = opts or {}

	installFocusHook()

	local win = Windows[title]
	local isNew = false

	if not win then
		isNew = true
		win = {
			title = title,
			x = opts.x or 100,
			y = opts.y or 100,
			w = opts.w or 300,
			h = opts.h or 400,
			nextOrder = 0,
			lastSeenFrame = -1,
			collapsed = false,
			openFlag = true,
		}

		Windows[title] = win
		createWindowInstances(win)
	end

	win.closeBtn.Visible = opts.closable or false

	if not win.openFlag then
		win.root.Visible = false
		return false
	end

	-- A brand-new window starts focused, same as upstream.
	if isNew then
		setFocusedWindow(win)
	end

	win.nextOrder = 0
	win.body = win.baseBody
	win.activeTabBar = nil

	win.lastSeenFrame = ImGui._frame
	win.root.Visible = true
	win.body.Visible = not win.collapsed
	win.grip.Visible = not win.collapsed

	win.root.Size = win.collapsed
		and UDim2.fromOffset(win.w, Style.TitleBarHeight)
		or UDim2.fromOffset(win.w, win.h)

	-- Do not set collapseIcon.Rotation here.
	-- The click handler controls it so the tween can finish.

	table.insert(WindowStack, win)

	return true
end

function ImGui.OpenWindow(title)
	local win = Windows[title]

	if win then
		win.openFlag = true
	end
end

-- Text/TextDisabled/Separator have no label to derive a stable identity
-- from, so they're named by their position in the draw order
-- ("textd_3", "sep_7", ...). That's fine as long as the exact same
-- widgets draw in the exact same order every frame — but a
-- CollapsingHeader (or any other conditional content) breaks that:
-- when it's collapsed vs expanded, the widgets AFTER it shift position,
-- so they get a different name and a brand-new Instance is created
-- instead of reusing the old one. The old one never gets removed on
-- its own, so toggling things open/closed repeatedly piled up ghost
-- duplicate Instances forever — this sweep is what actually removes
-- them. Every widget function stamps its root Instance with the
-- current frame number (see the SetAttribute("_imgui_f", ...) calls
-- throughout); anything in win.baseBody carrying that attribute from
-- an OLDER frame means it wasn't drawn this frame, so it's gone stale
-- and gets destroyed.
local function reapStaleWidgets(win)
	for _, child in ipairs(win.baseBody:GetChildren()) do
		local f = child:GetAttribute("_imgui_f")
		if f ~= nil and f ~= ImGui._frame then
			child:Destroy()
		end
	end
end

function ImGui.End()
	local win = currentWindow()
	if win then
		reapStaleWidgets(win)
	end
	table.remove(WindowStack)
end

--========================================================================
-- TABS
--========================================================================

local function createTabBar(win, id)
	-- Outer container: NOT governed by any UIListLayout of its own, so
	-- it can hold a full-width underline frame safely. This is what
	-- gets the vertical LayoutOrder slot inside win.baseBody.
	local tabBar = Instance.new("Frame")
	tabBar.Name = "TabBar_" .. id
	tabBar.BackgroundTransparency = 1
	tabBar.Size = UDim2.new(1, 0, 0, Style.TabBarHeight)
	tabBar.LayoutOrder = 1
	tabBar.Parent = win.baseBody

	-- The Separator line upstream draws under the whole tab bar. It
	-- sits BEHIND every tab (ZIndex 0 vs tabs' default 1), so it's only
	-- actually visible: (a) under inactive tabs, which paintTab() makes
	-- TAB_BAR_GAP px short to expose it, and (b) in the empty stretch
	-- of the bar past the last tab, same as upstream.
	--
	-- This MUST live directly in tabBar, not in tabButtonsRow below —
	-- a Horizontal UIListLayout treats every child as a list item, so
	-- a full-width (Size X scale = 1) sibling of the tab buttons gets
	-- laid out AS a list item and claims the whole row's width for
	-- itself, shoving the real tabs almost entirely off-screen. That
	-- was the actual bug behind the broken-looking tab bar.
	local underline = Instance.new("Frame")
	underline.Name = "Underline"
	underline.BackgroundColor3 = Style.Border
	underline.BackgroundTransparency = Style.BorderTransparency
	underline.BorderSizePixel = 0
	underline.Size = UDim2.new(1, 0, 0, 1)
	underline.Position = UDim2.new(0, 0, 1, -1)
	underline.ZIndex = 0
	underline.Parent = tabBar

	-- Inner strip: ONLY the actual tab buttons live here, so the
	-- horizontal UIListLayout only ever lays out real tabs.
	local tabButtonsRow = Instance.new("Frame")
	tabButtonsRow.Name = "TabButtons"
	tabButtonsRow.BackgroundTransparency = 1
	tabButtonsRow.Size = UDim2.new(1, 0, 1, 0)
	tabButtonsRow.ZIndex = 1
	tabButtonsRow.Parent = tabBar

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Padding = UDim.new(0, 2)
	tabLayout.Parent = tabButtonsRow

	local pages = Instance.new("Frame")
	pages.Name = "TabPages_" .. id
	pages.BackgroundTransparency = 1
	pages.Size = UDim2.new(1, 0, 0, 0)
	pages.AutomaticSize = Enum.AutomaticSize.Y
	pages.LayoutOrder = 2
	pages.Parent = win.baseBody

	local pagesLayout = Instance.new("UIListLayout")
	pagesLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pagesLayout.Parent = pages

	local state = {
		id = id,
		win = win,
		tabBar = tabBar,               -- outer container (vertical LayoutOrder slot)
		tabButtonsRow = tabButtonsRow, -- inner strip (parent for actual tab buttons)
		pages = pages,
		tabs = {},
		tabsById = {},
		selected = nil,
	}

	win.tabBars[id] = state

	return state
end

local function getTabBar(win, id)
	return win.tabBars[id] or createTabBar(win, id)
end

local function createTab(state, label)
	local visible, id = splitLabel(label)
	local win = state.win

	local page = Instance.new("Frame")
	page.Name = "Page_" .. id
	page.BackgroundTransparency = 1
	page.Size = UDim2.new(1, 0, 0, 0)
	page.AutomaticSize = Enum.AutomaticSize.Y
	page.Visible = false
	page.LayoutOrder = #state.tabs + 1
	page.Parent = state.pages

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Padding = UDim.new(0, Style.ItemSpacingY)
	pageLayout.Parent = page

	local pagePadding = Instance.new("UIPadding")
	pagePadding.PaddingTop = UDim.new(0, Style.WindowPaddingY)
	pagePadding.PaddingBottom = UDim.new(0, Style.WindowPaddingY)
	pagePadding.PaddingLeft = UDim.new(0, 0)
	pagePadding.PaddingRight = UDim.new(0, 0)
	pagePadding.Parent = page

	-- Auto-width to fit the label (upstream sizes tabs to their text +
	-- FramePadding.x*2, not a fixed box) with a sensible floor so a
	-- one-letter tab isn't a sliver.
	local button = Instance.new("TextButton")
	button.Name = "Tab_" .. id
	button.BackgroundColor3 = Style.Tab
	button.BackgroundTransparency = Style.TabTransparency
	button.BorderSizePixel = 0
	button.AutomaticSize = Enum.AutomaticSize.X
	button.Size = UDim2.new(0, 0, 1, 0)
	button.Font = Style.Font
	button.TextSize = Style.TextSize
	button.TextColor3 = Style.Text
	button.Text = visible
	button.AutoButtonColor = false
	button.LayoutOrder = #state.tabs + 1
	button.ClipsDescendants = false
	button.Parent = state.tabButtonsRow

	local btnSizeConstraint = Instance.new("UISizeConstraint")
	btnSizeConstraint.MinSize = Vector2.new(40, 0)
	btnSizeConstraint.Parent = button

	-- Upstream pads each side by FramePadding.x (not *2) — the previous
	-- version doubled this, which made every tab noticeably wider/
	-- puffier than real ImGui.
	local btnPadding = Instance.new("UIPadding")
	btnPadding.PaddingLeft = UDim.new(0, Style.FramePaddingX)
	btnPadding.PaddingRight = UDim.new(0, Style.FramePaddingX)
	btnPadding.Parent = button

	-- Top corners rounded (TabRounding), bottom squared off via mask —
	-- matches upstream's top-rounded/bottom-flush tab shape. The mask
	-- is re-colored every paintTab() call below (it was previously
	-- frozen at creation time, leaving a visible two-tone seam at the
	-- bottom of active/hovered tabs — that was the main thing making
	-- these look off).
	corner(button, Style.TabRounding)
	local mask = squareBottomMask(button, Style.Tab, Style.TabTransparency, 4)

	local tab = {
		id = id,
		label = visible,
		page = page,
		button = button,
		mask = mask,
		hovered = false,
	}

	button.MouseEnter:Connect(function()
		tab.hovered = true
		paintTab(tab, state, win.titleFocused)
	end)

	button.MouseLeave:Connect(function()
		tab.hovered = false
		paintTab(tab, state, win.titleFocused)
	end)

	button.MouseButton1Click:Connect(function()
		state.selected = id
		updateTabVisuals(state, win.titleFocused)
	end)

	table.insert(state.tabs, tab)
	state.tabsById[id] = tab

	if not state.selected then
		state.selected = id
	end

	return tab
end

function ImGui.BeginTabBar(id)
	local win = currentWindow()

	if not win then
		return false
	end

	win.body = win.baseBody

	local state = getTabBar(win, id)

	win.activeTabBar = state
	win.nextOrder = 0

	state.tabBar.LayoutOrder = nextOrder()
	state.pages.LayoutOrder = nextOrder()

	updateTabVisuals(state, win.titleFocused)

	return true
end

function ImGui.BeginTabItem(label)
	local win = currentWindow()

	if not win or not win.activeTabBar then
		return false
	end

	local state = win.activeTabBar
	local visible, id = splitLabel(label)

	local tab = state.tabsById[id]

	if not tab then
		tab = createTab(state, label)
		updateTabVisuals(state, win.titleFocused)
	end

	if state.selected ~= id then
		return false
	end

	win.body = tab.page
	win.nextOrder = 0
	win.activeTabPage = tab.page

	return true
end

function ImGui.EndTabItem()
	local win = currentWindow()

	if not win then
		return
	end

	win.body = win.baseBody
	win.activeTabPage = nil
end

function ImGui.EndTabBar()
	local win = currentWindow()

	if not win then
		return
	end

	win.body = win.baseBody
	win.activeTabBar = nil
	win.activeTabPage = nil
end

