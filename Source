local function sliderCore(id, win, order, label, value, min, max, fmt, isInt)
	local name = "sld_" .. id

	local state = getState(scopedId(win, id), {
		value = value,
		dragging = false,
	})

	if state.value == nil then
		state.value = value
	end

	local row = win.body:FindFirstChild(name)

	if not row then
		row = Instance.new("Frame")
		row.Name = name
		row.BackgroundColor3 = Style.FrameBg
		row.BackgroundTransparency = Style.FrameBgTransparency
		row.Size = UDim2.new(1, 0, 0, Style.FrameHeight)
		row.Parent = win.body

		corner(row, Style.FrameRounding)

		local grab = Instance.new("Frame")
		grab.Name = "Grab"
		grab.BackgroundColor3 = Style.SliderGrab
		grab.BackgroundTransparency = Style.SliderGrabTransparency
		grab.BorderSizePixel = 0
		grab.Size = UDim2.fromOffset(
			Style.GrabMinSize,
			Style.FrameHeight - 4
		)
		grab.Position = UDim2.new(
			0, 0,
			0.5, -(Style.FrameHeight - 4) / 2
		)
		grab.ZIndex = 2
		grab.Parent = row

		corner(grab, Style.GrabRounding)

		local text = Instance.new("TextLabel")
		text.Name = "Label"
		text.BackgroundTransparency = 1
		text.Size = UDim2.new(1, -12, 1, 0)
		text.Position = UDim2.fromOffset(6, 0)
		text.Font = Style.Font
		text.TextSize = Style.TextSize
		text.TextColor3 = Style.Text
		text.TextTransparency = Style.TextTransparency
		text.TextXAlignment = Enum.TextXAlignment.Center
		text.ZIndex = 3
		text.Parent = row

		local dragRegion = Instance.new("TextButton")
		dragRegion.Name = "DragRegion"
		dragRegion.BackgroundTransparency = 1
		dragRegion.Text = ""
		dragRegion.Size = UDim2.new(1, 0, 1, 0)
		dragRegion.ZIndex = 4
		dragRegion.Parent = row

		local function setFromX(xPos)
			local width = row.AbsoluteSize.X

			if width <= 0 then
				return
			end

			local rel = math.clamp(
				(xPos - row.AbsolutePosition.X) / width,
				0,
				1
			)

			local raw = min + (max - min) * rel

			if isInt then
				raw = math.floor(raw + 0.5)
			end

			state.value = raw
			state.changed = true
		end

		dragRegion.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				state.dragging = true
				setFromX(input.Position.X)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if state.dragging and (
				input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				) then
				setFromX(input.Position.X)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then

				state.dragging = false
			end
		end)
	end

	row.LayoutOrder = order
	row:SetAttribute("_imgui_f", ImGui._frame)

	local rel = (max > min)
		and (state.value - min) / (max - min)
		or 0

	rel = math.clamp(rel, 0, 1)

	local travel = row.AbsoluteSize.X > 0
		and (row.AbsoluteSize.X - Style.GrabMinSize)
		or 0

	row.Grab.Position = UDim2.new(
		0,
		rel * travel,
		0.5,
		-(Style.FrameHeight - 4) / 2
	)

	row.Grab.BackgroundColor3 = state.dragging
		and Style.SliderGrabActive
		or Style.SliderGrab

	row.Grab.BackgroundTransparency = state.dragging
		and Style.SliderGrabActiveTransparency
		or Style.SliderGrabTransparency

	row.Label.Text = label .. ": " .. string.format(fmt, state.value)

	local changed = state.changed or false
	state.changed = false

	return changed, state.value
end

